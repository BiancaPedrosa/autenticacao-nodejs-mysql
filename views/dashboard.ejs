<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f5f5f5; }
        .card {
            max-width: 360px;
            margin: 80px auto;
            padding: 24px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
        }
        button {
            padding: 8px 16px;
            background: #c0392b;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Bem-vindo, <%= username %>!</h2>
        <p>Este é o seu dashboard.</p>
        <form method="POST" action="/logout">
            <button type="submit">Logout</button>
        </form>
    </div>
</body>
</html>
